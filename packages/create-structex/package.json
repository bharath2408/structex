{
  "name": "@bharath2408/create-structex",
  "version": "0.5.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Scaffold and generate Structex applications. Run with npx, no install required.",
  "type": "module",
  "bin": {
    "create-structex": "dist/index.js",
    "structex": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "structex",
    "express",
    "cli",
    "scaffold",
    "generator",
    "boilerplate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharath2408/structex.git",
    "directory": "packages/create-structex"
  },
  "homepage": "https://github.com/bharath2408/structex#readme"
}
